# @BotFather dan olingan bot token
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sizning Telegram ID'ingiz (https://t.me/userinfobot dan bilib olasiz)
OWNER_ID=123456789

# Webhook URL (Railway deploy qilganda avtomatik to'ldirasiz)
# Masalan: https://your-app.railway.app
WEBHOOK_HOST=

# Webhook port (Railway uchun 8080)
WEBHOOK_PORT=8080

# SQLite DB fayl joyi
DB_PATH=data/messages.db
